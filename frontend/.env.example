# Where the Next.js route handlers forward /api/* to (Spring Boot).
# Use http://localhost:4010 to run against the Prism mock of docs/api/openapi.yaml.
BACKEND_URL=http://localhost:8080

# Keycloak (OIDC sign-in). The issuer is the same URL for the browser, this server and the backend.
KEYCLOAK_ISSUER=http://localhost:8180/realms/sharewise
KEYCLOAK_CLIENT_ID=sharewise-web
# Public address of this app; redirects after login and logout are built from it.
APP_URL=http://localhost:3000
