<mxfile host="app.diagrams.net">
  <diagram id="sharewise-team" name="ShareWise team model">
    <mxGraphModel dx="2112" dy="1348" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3000" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fillColor=none;strokeColor=none;" value="&lt;b style='font-size:18px'&gt;ShareWise – class diagram (team version 17.10.26 + Account context added 18.10.26, simple login added 19.10.26) – &lt;span style=&quot;color:#D08A2E&quot;&gt;Account with external identity provider&lt;/span&gt;&lt;/b&gt;&lt;br/&gt;Dashed boxes = aggregates. Aggregates refer to each other by ID only and react to each other's domain events (DDD slides 64–71). Purple dashed arrow = publishes, orange dashed arrow = subscribes to, ◆ = composition (part of the aggregate), grey dashed = uses / references by ID. Colours: cyan aggregate root, blue entity, green value object, yellow enumeration, pink read model, purple domain events. Brown context = generic subdomain." vertex="1">
          <mxGeometry height="100" width="1500" y="-130" as="geometry" />
        </mxCell>
        <mxCell id="G" parent="1" style="rounded=1;arcSize=1;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#FAF6EC;strokeColor=#86681A;fontColor=#86681A;" value="Group context" vertex="1">
          <mxGeometry height="865" width="1359" as="geometry" />
        </mxCell>
        <mxCell id="AG" parent="G" style="rounded=1;arcSize=2;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#0E8FA3;fontColor=#0E8FA3;dashed=1;dashPattern=8 4;strokeWidth=2;" value="«Aggregate» Group" vertex="1">
          <mxGeometry height="785" width="949" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="Group" parent="AG" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DAF5F9;strokeColor=#0E8FA3;strokeWidth=2;" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Group&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ id: GroupId&lt;br/&gt;+ name: GroupName&lt;br/&gt;+ currency: Currency&lt;br/&gt;+ status: GroupStatus&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ createGroup(GroupName name, Currency currency, UserId creator): GroupCreated&lt;br/&gt;+ inviteMember(Email, UserId adminOrMember): MemberInvited&lt;br/&gt;+ promoteToAdmin(UserId targetMember, UserId actingAdmin): MemberPromoted&lt;br/&gt;+ removeMember(UserId targetMember, UserId actingAdmin): MemberRemoved&lt;br/&gt;+ leaveGroup(UserId member): MemberLeft&lt;br/&gt;+ closeForSettlement(UserId actingAdmin): GroupClosedForSettlement&lt;br/&gt;+ reopenGroup(UserId actingAdmin): GroupReopened&lt;br/&gt;+ archiveGroup(UserId actingAdmin): GroupArchived&lt;br/&gt;+ acceptInvitation(InvitationId, UserId): MemberJoined&lt;br/&gt;+ declineInvitation(InvitationId): InvitationDeclined&lt;br/&gt;+ updateBalanceStatus(UserId member, boolean hasZeroBalance, Instant occurredAt)&lt;/p&gt;" vertex="1">
          <mxGeometry height="285" width="574" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="Membership" parent="AG" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DCE8FB;strokeColor=#2A63C6;" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Entity»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Membership&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ userId: UserId&lt;br/&gt;+ role: GroupRole&lt;br/&gt;+ status: MembershipStatus&lt;br/&gt;+ hasZeroBalance: boolean&lt;br/&gt;+ balanceStatusAt: Instant&lt;br/&gt;+ joinedAt: Instant&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="20" y="415" as="geometry" />
        </mxCell>
        <mxCell id="GroupStatus" parent="AG" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GroupStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;OPEN&lt;br/&gt;CLOSED_FOR_SETTLEMENT&lt;br/&gt;ARCHIVED&lt;/p&gt;" vertex="1">
          <mxGeometry height="95" width="175" x="280" y="415" as="geometry" />
        </mxCell>
        <mxCell id="Invitation" parent="AG" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DCE8FB;strokeColor=#2A63C6;" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Entity»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Invitation&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ id: InvitationId&lt;br/&gt;+ invitee: UserId&lt;br/&gt;+ status: InvitationStatus&lt;br/&gt;+ expiresAt: Instant&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ accept(UserId user)&lt;br/&gt;+ decline()&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="210" x="505" y="415" as="geometry" />
