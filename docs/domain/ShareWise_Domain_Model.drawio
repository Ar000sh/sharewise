        <mxCell id="InvitationStatus" parent="AG" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;InvitationStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;PENDING&lt;br/&gt;ACCEPTED&lt;br/&gt;DECLINED&lt;br/&gt;EXPIRED&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="182" x="519" y="645" as="geometry" />
